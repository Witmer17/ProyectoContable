# Autenticación (generar con: openssl rand -hex 32)
JWT_SECRET=cambiar_por_un_secreto_largo
# Contraseña inicial de los usuarios sembrados (admin_juan, contador_juana, auditor_carlos, gerente_ana)
SEED_USER_PASSWORD=cambiar_clave_inicial
CORS_ORIGINS=http://localhost:4200
